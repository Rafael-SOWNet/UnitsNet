{
  "Name": "LogicState",
  "Namespace": "Probe.Logic",
  "BaseUnit": "Logic",
  "XmlDocSummary": "A two-valued logic state, stored as <c>0</c> (false) or <c>1</c> (true). Units are named <em>senses</em> of the same bit: each declares which real-world condition corresponds to logical true. Converting between senses of the same polarity is the identity; converting across opposite polarities is negation.",
  "XmlDocRemarks": "Sense names follow KNX datapoint types 1.xxx (ISO/IEC 14543-3) and the BACnet Binary Input Polarity property. KNX defines DPT 1.009 DPT_OpenClose as 0=open, 1=close and DPT 1.019 DPT_Window_Door as 0=closed, 1=open, so the same physical condition is standardised in both polarities. That is the case this quantity exists to handle.",
  "BaseDimensions": {},
  "Units": [
    {
      "SingularName": "Logic",
      "PluralName": "Logic",
      "FromUnitToBaseFunc": "{x}",
      "FromBaseToUnitFunc": "{x}",
      "XmlDocSummary": "Canonical sense: <c>1</c> is true, <c>0</c> is false. KNX DPT 1.002 DPT_Bool.",
      "Localization": [ { "Culture": "en-US", "Abbreviations": [ "bool", "logic" ] } ]
    },

    {
      "SingularName": "Active",
      "PluralName": "Active",
      "FromUnitToBaseFunc": "{x}",
      "FromBaseToUnitFunc": "{x}",
      "XmlDocSummary": "<c>1</c> is active. BACnet <c>ACTIVE</c>; KNX DPT 1.011 DPT_State.",
      "Localization": [ { "Culture": "en-US", "Abbreviations": [ "act" ] } ]
    },
    {
